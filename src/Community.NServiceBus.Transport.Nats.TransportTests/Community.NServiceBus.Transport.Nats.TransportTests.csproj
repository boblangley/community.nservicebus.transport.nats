  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Community.NServiceBus.Transport.Nats\Community.NServiceBus.Transport.Nats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NServiceBus.TransportTests.Sources" Version="10.2.0" />
  </ItemGroup>

</Project>
